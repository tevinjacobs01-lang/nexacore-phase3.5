# Backend
DATABASE_URL=postgresql://nexacore:nexacore@db:5432/nexacore
JWT_SECRET_KEY=change_me_to_a_random_64_char_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Postgres (used by docker-compose)
POSTGRES_USER=nexacore
POSTGRES_PASSWORD=nexacore
POSTGRES_DB=nexacore

# AI Assistant (optional — assistant endpoints return 503 with a clear message if unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
